    "advanced.tool.topicSelection.description": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta numeri di temi candidati con diagnostici nominati e validazione su documenti esclusi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare candidate topic counts with named diagnostics and held-out validation."
          }
        }
      }
    },
    "advanced.tool.topicSelection.caveat": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostici di training e qualità su documenti esclusi sono distinti. I valori non definiti mantengono il motivo; i pareggi favoriscono il numero di temi più piccolo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training diagnostics and held-out quality are distinct. Undefined values retain their reason; ties favor the smaller topic count."
          }
        }
      }
    },
