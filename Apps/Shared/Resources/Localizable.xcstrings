    "advanced.tool.mdsSearch.title": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca MDS con più avvii"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MDS with multiple starts"
          }
        }
      }
    },
    "advanced.tool.mdsSearch.description": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta configurazioni casuali riproducibili e conserva coordinate e diagnostici di ogni avvio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare reproducible random configurations and retain coordinates and diagnostics for every start."
          }
        }
      }
    },
    "advanced.tool.mdsSearch.caveat": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’avvio scelto minimizza l’obiettivo finale; non è una prova della stabilità scientifica. Anche gli avvii non convergenti restano ispezionabili."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen start minimizes the final objective; it does not establish scientific stability. Non-converged starts remain inspectable."
          }
        }
      }
    },
    "advanced.tool.somAdvanced.title": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SOM: geometria, U-matrix e Ward"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SOM: geometry, U-matrix and Ward"
          }
        }
      }
    },
    "advanced.tool.somAdvanced.description": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una griglia rettangolare o esagonale, esplora i prototipi e confronta i gruppi Ward opzionali."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose rectangular or hexagonal geometry, inspect codebooks and compare optional Ward clusters."
          }
        }
      }
    },
    "advanced.tool.somAdvanced.caveat": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La U-matrix riporta la mediana delle distanze euclidee dai prototipi vicini. I gruppi Ward sono una composizione sui prototipi e conservano l’ordine delle unità."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The U-matrix reports the median Euclidean distance to neighboring codebooks. Ward clusters are a composition over codebooks and preserve unit order."
          }
        }
      }
    },
    "advanced.tool.topicSelection.title": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezione del numero di temi"
          }
