          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello richiesto non consente questo calcolo numerico. Correggi il livello di confidenza e riprova; i risultati precedenti restano disponibili."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The requested level does not permit this numerical calculation. Correct the confidence level and retry; previous results remain available."
          }
        }
      }
    },
