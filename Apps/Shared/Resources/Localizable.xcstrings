    "linguistic.limits-help": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesta canonica fino a 1 MiB; massimo 200 unità e 256 variabili per unità. Il motore limita token, campi e risultati prima della pubblicazione. I dati non vengono troncati per farli rientrare nei limiti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canonical request up to 1 MiB; up to 200 units and 256 variables per unit. The engine bounds tokens, fields and results before publication. Data are never truncated to fit these limits."
          }
        }
      }
    },
