      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una coppia x y per riga, nello stesso ordine dei nodi. L’inizializzazione e il seed vengono conservati con il risultato."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One x y pair per row, in node order. Initialization and seed are retained with the result."
          }
        }
      }
    },
    "operators.layout-semantics": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coordinate adimensionali descrivono la disposizione della rete. Il calcolo usa la topologia degli archi positivi con la policy del metodo; consulta energia e convergenza."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensionless coordinates describe the network layout. Computation uses positive-edge topology with the method’s policy; review energy and convergence."
          }
        }
      }
    },
    "operators.forest-semantics": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pesi sono costi non negativi; zero è ammesso. La proiezione non orientata usa il costo minimo degli archi paralleli o reciproci. Le componenti scollegate restano distinte."
          }
        },
