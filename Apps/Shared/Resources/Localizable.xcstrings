    "linguistic.offset-help": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token numerati da uno; frasi e paragrafi da zero, secondo il contratto del motore. Gli intervalli sono byte UTF-8 del testo fornito allo strumento: inizio incluso, fine esclusa. Per le copie dal progetto si riferiscono al testo estratto mostrato nell’editor. POS conserva i tag grezzi Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens are numbered from one; sentences and paragraphs from zero, according to the engine contract. Ranges are UTF-8 bytes in the supplied text: start inclusive, end exclusive. For project copies they refer to the extracted text shown in the editor. POS retains raw Apple tags."
          }
        }
      }
    },
