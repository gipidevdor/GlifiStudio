    "statistics.result-caveat": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "p-value, effetti e intervalli descrivono il metodo e il disegno dichiarati. Non dimostrano causalità o rilevanza pratica. I numeri mostrati usano fino a 12 cifre significative; il JSON conserva i valori completi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "P-values, effects and intervals describe the declared method and design. They do not establish causality or practical relevance. Displayed numbers use up to 12 significant digits; JSON preserves the complete values."
          }
        }
      }
    },
    "statistics.posthoc-caveat": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunn restituisce p grezze; Tukey e Games–Howell restituiscono p della rispettiva procedura. Nei contrasti le colonne distinguono p grezza, Bonferroni e BH. Non scegliere o ridurre la famiglia dopo aver visto i risultati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunn returns raw p-values; Tukey and Games–Howell return procedure-specific p-values. Contrasts distinguish raw, Bonferroni and BH columns. Do not choose or reduce the family after inspecting results."
          }
        }
      }
    },
