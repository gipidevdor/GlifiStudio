    "advanced.maximum-terms" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termini nella matrice"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix term limit"
          }
        }
      }
    },
    "advanced.matrix-policy" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La matrice usa conteggi grezzi dei termini più frequenti nell’ambito scelto, con pareggi in ordine lessicografico. Il limite seleziona il vocabolario prima del calcolo; non è una stoplist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The matrix uses raw counts of the most frequent terms in the selected scope, with lexical ties. The limit selects the vocabulary before calculation; it is not a stoplist."
          }
        }
      }
    },
    "advanced.full-token-policy" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo strumento usa tutti i token lessicali o il testo estratto completo delle fonti selezionate, entro i limiti dichiarati. Il limite della matrice non riduce questi input."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tool uses all lexical tokens or the complete extracted text of the selected sources, within the stated bounds. The matrix limit does not reduce these inputs."
          }
        }
      }
    },
    "advanced.limits" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiti del laboratorio: 200 fonti, 8 MiB di fonti originali, 100.000 token lessicali e 1–1.000 termini nella matrice. Richieste serializzate: massimo 1 MiB. Un limite superato interrompe l’operazione; le fonti non vengono campionate di nascosto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laboratory limits: 200 sources, 8 MiB of original source data, 100,000 lexical tokens and 1–1,000 matrix terms. Serialized requests: up to 1 MiB. Exceeding a limit stops the operation; sources are never silently sampled."
          }
        }
      }
    },
