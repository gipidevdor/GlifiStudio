    "frequency.words.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts sequences of normalized lexical forms within one document. Punctuation is excluded; a sequence may cross sentences, but never different sources."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta sequenze di forme lessicali normalizzate nello stesso documento. La punteggiatura è esclusa; una sequenza può attraversare frasi, mai fonti diverse."
          }
        }
      }
    },
    "frequency.characters.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts sequences of perceived Unicode characters (grapheme clusters) within each normalized lexical form. Sequences do not cross words."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta sequenze di caratteri Unicode percepiti (grapheme cluster) dentro ogni forma lessicale normalizzata. Le sequenze non attraversano parole."
          }
        }
      }
    },
    "frequency.padded-characters.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts perceived Unicode characters within each normalized lexical form, adding _ at the beginning and end to mark word boundaries. Sequences do not cross words."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta caratteri Unicode percepiti dentro ogni forma lessicale normalizzata, aggiungendo _ all’inizio e alla fine per indicare i confini della parola. Le sequenze non attraversano parole."
          }
        }
      }
    },
