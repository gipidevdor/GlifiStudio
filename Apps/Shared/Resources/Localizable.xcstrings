    "statistics.limits.description": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati espliciti: 1 MiB di testo, 100 000 osservazioni, 64 gruppi o codificatori e 256 categorie. I post-hoc ammettono 20 gruppi. Il ricampionamento ha un budget esplicito di 20 milioni di unità di lavoro. Il superamento produce un errore: nessun dato viene troncato."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit data: 1 MiB of text, 100,000 observations, 64 groups or raters, and 256 categories. Post-hoc procedures accept 20 groups. Resampling has an explicit budget of 20 million work units. Exceeding a limit produces an error; data are never truncated."
          }
        }
      }
    },
