    "weighting.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta il peso dei termini nei documenti combinando frequenza, diffusione nella raccolta e normalizzazione. I pesi non sono probabilità né significatività statistica."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare term weights across documents using frequency, prevalence in the collection, and normalization. Weights are neither probabilities nor statistical significance."
          }
        }
      }
    },
