      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le comunità usano una proiezione non orientata: le forze degli archi si sommano e i cappi sono esclusi. Il risultato registra la risoluzione e la gerarchia del metodo."
          }
        },
        "en": {
          "stringUnit": {
