    "advanced.group-help" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna un gruppo a ogni fonte. I campi vuoti restano mancanti: sono conteggiati separatamente e non diventano un gruppo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign a group to each source. Empty fields remain missing: they are counted separately and do not become a group."
          }
        }
      }
    },
    "advanced.validation-label-help" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna una classe a ogni fonte. Ogni partizione ricostruisce il modello usando soltanto i documenti di addestramento; servono abbastanza esempi per ciascuna classe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign a class to every source. Each fold rebuilds the model using only training documents; each class needs enough examples."
          }
        }
      }
    },
    "advanced.classification-label-help" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna una classe ai documenti di addestramento. Lascia vuota la classe delle fonti da classificare. Addestramento e previsione usano insiemi distinti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign a class to training documents. Leave the class empty for sources to predict. Training and prediction use separate sets."
          }
        }
      }
    },
