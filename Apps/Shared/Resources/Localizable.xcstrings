    "advanced.topic-selection-help": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi i numeri candidati separati da spazi, senza duplicati. Indica almeno due fold per la perplessità su documenti esclusi; zero fold calcola soltanto i diagnostici degli altri criteri. I token sconosciuti sono contati ed esclusi esplicitamente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter distinct candidate counts separated by spaces. Use at least two folds for held-out perplexity; zero folds computes only diagnostics for the other criteria. Unknown tokens are counted and explicitly excluded."
          }
        }
      }
    },
    "advanced.completion-limits": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca MDS: fino a 32 avvii. SOM avanzata: fino a 256 unità. Le tabelle ammettono complessivamente 100 000 righe; oltre il limite l’operazione si arresta senza troncare risultati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MDS search: up to 32 starts. Advanced SOM: up to 256 units. Tables admit 100,000 rows in total; exceeding the limit stops the operation without truncating results."
          }
        }
      }
    },
