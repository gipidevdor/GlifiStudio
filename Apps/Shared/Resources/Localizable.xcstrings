    "evaluation.partition.help": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni intervallo include l’inizio ed esclude la fine. Mesi e anni richiedono origine allineata al primo giorno. Date civili e istanti non possono essere mescolati. Intervalli incerti e periodi non sono assegnabili da questa variante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each interval includes its start and excludes its end. Months and years require an origin aligned to the first day. Civil dates and instants cannot be mixed. Uncertain intervals and periods cannot be assigned by this variant."
          }
        }
      }
    },
