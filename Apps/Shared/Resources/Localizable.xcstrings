    "weighting.tf.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TF trasforma il conteggio nel singolo documento: conteggio, presenza, quota sul totale, rapporto con il massimo, frequenza aumentata o scala logaritmica. Le trasformazioni non aggiungono termini assenti."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TF transforms a count within one document: count, presence, share of total, ratio to maximum, augmented frequency, or logarithmic scale. These transformations do not add absent terms."
          }
        }
      }
    },
    "weighting.idf.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDF usa il numero di documenti che contengono il termine. Senza IDF il metodo è solo TF. Con IDF non smussata, un termine presente in tutti i documenti ha peso zero; la variante smussata mantiene un fattore positivo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDF uses the number of documents containing a term. Without IDF the method is TF only. With unsmoothed IDF, a term in every document has zero weight; smooth IDF keeps a positive factor."
          }
        }
      }
    },
    "weighting.normalization.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La normalizzazione si applica ai pesi dell’intera riga dopo TF e IDF: nessuna, somma assoluta L1 o lunghezza euclidea L2. Una riga con soli pesi zero rimane a zero."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalization applies to the whole row after TF and IDF: none, absolute sum L1, or Euclidean length L2. A row with only zero weights stays zero."
          }
        }
      }
    },
    "weighting.limits.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limiti standard di calcolo: 1 000 fonti, 256 MiB di fonti, 100 000 termini e 500 000 celle osservate. Il risultato ammesso è completo: le pagine non troncano il calcolo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard computation limits: 1,000 sources, 256 MiB of source data, 100,000 terms, and 500,000 observed cells. An admitted result is complete: pagination does not truncate computation."
          }
        }
      }
    },
