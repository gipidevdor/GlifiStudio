    "keyness.mac.diagnostic.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il minimo atteso è sotto la soglia diagnostica di questa richiesta. Il segnale riguarda l’approssimazione asintotica e non è un giudizio sulla grandezza o sulla certezza dell’effetto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The minimum expected count is below this request’s diagnostic threshold. This signal concerns the asymptotic approximation, not effect magnitude or certainty."
          }
        }
      }
    },
    "keyness.mac.page.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinquanta termini per pagina. Precedente, successiva, ultima e pagina diretta non ricalcolano né riducono la famiglia. Inserisci un numero fra 1 e il totale indicato; un numero non valido non cambia pagina."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifty terms per page. Previous, next, last, and direct page access neither recompute nor reduce the family. Enter a number from 1 to the displayed total; an invalid number does not change the page."
          }
        }
      }
    },
    "keyness.mac.method.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il confronto usa conteggi token-based e correzione BH sull’intera famiglia. p e q non sono probabilità che un’ipotesi sia vera. L’assenza di fonti condivise fra i gruppi non dimostra indipendenza statistica delle osservazioni; gli esiti non stabiliscono cause."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The comparison uses token-based counts and BH correction across the full family. p and q are not probabilities that a hypothesis is true. Disjoint source groups do not establish statistical independence of observations; results do not establish causes."
          }
        }
      }
    },
    "keyness.mac.test.selection" : {
