    "linguistic.prediction-help": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemmi e POS usano i servizi Apple installati. Gli stem seguono le regole Snowball; restano distinti dai lemmi. Gli stati delle annotazioni assenti sono mostrati nel risultato."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemmas and POS use installed Apple services. Stems follow Snowball rules and remain distinct from lemmas. States of absent annotations are shown in the result."
          }
        }
      }
    },
