      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una intestazione *Nome precede ciascuna regola. Le regole lavorano sulla base lessicale selezionata; gli intervalli di evidenza restano nel testo originale. Le annotazioni richieste ma sconosciute producono un errore."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A *Name heading precedes each rule. Rules use the selected lexical view; evidence ranges stay in the original text. Required but unknown annotations produce an error."
          }
        }
      }
    },
