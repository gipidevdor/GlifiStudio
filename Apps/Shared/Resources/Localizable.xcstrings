    "operators.numeric-help": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga per osservazione, valori separati da spazi o TAB. Decimali con virgola o punto; nessun separatore delle migliaia. Per le similarità inserisci due vettori, per Lidstone una riga di conteggi. Le probabilità devono già sommare a uno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One row per observation, values separated by spaces or TAB. Use a comma or dot for decimals; no thousands separator. Enter two vectors for similarities, or one count row for Lidstone. Probabilities must already sum to one."
          }
        }
      }
    },
