            "state": "translated",
            "value": "Explicit data"
          }
        }
      }
    },
    "statistics.input.series": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga con tutti i valori della serie. Solo le descrittive ammettono ? come valore mancante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One row containing every value in the series. Only descriptive statistics accept ? for missing observations."
          }
        }
      }
    },
    "statistics.input.pairedSeries": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due righe, una per ciascuna serie. Nei metodi appaiati i valori nella stessa posizione costituiscono una coppia: lunghezze diverse o dati mancanti non vengono corretti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two rows, one per series. For paired methods, values at the same position form a pair: unequal lengths and missing data are not corrected."
          }
        }
      }
    },
    "statistics.input.groups": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga per ciascun gruppo indipendente; i gruppi mantengono questo ordine nei confronti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One row per independent group; comparisons retain this group order."
          }
        }
      }
    },
    "statistics.input.counts": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga per ogni riga della tabella di conteggi, con uguale numero di colonne. Sono ammessi soltanto interi non negativi. Fisher richiede una tabella 2 × 2."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One line per count-table row, with equal column counts. Only non-negative integers are accepted. Fisher requires a 2 × 2 table."
          }
        }
      }
    },
    "statistics.input.categories": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga per unità e giudizi dei codificatori separati da TAB. Le categorie possono contenere spazi. Usa ? o una cella vuota per un giudizio mancante; Cohen e Fleiss richiedono giudizi completi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One row per unit, with coder judgments separated by TAB. Categories may contain spaces. Use ? or an empty cell for missing judgments; Cohen and Fleiss require complete judgments."
          }
        }
      }
    },
    "statistics.input.ratings": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga per unità e valori numerici dei codificatori separati da spazi o TAB. Usa ? per un giudizio mancante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One row per unit, with numeric coder values separated by spaces or TAB. Use ? for missing judgments."
          }
        }
      }
    },
    "statistics.input.format": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numeri separati da spazi o TAB, mai da virgole. Punto o virgola decimale sono ammessi; i separatori delle migliaia non lo sono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate numbers with spaces or TAB, never commas. Decimal points or commas are accepted; thousands separators are not."
          }
        }
      }
    },
