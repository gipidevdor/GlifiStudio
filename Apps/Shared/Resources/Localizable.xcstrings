          "stringUnit" : {
            "state" : "translated",
            "value" : "All comparison terms"
          }
        }
      }
    },
    "keyness.mac.terms.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Famiglia completa, ordinata da Kit per valore assoluto del log ratio decrescente e termine crescente a parità. Nessun filtro di p-value o riordino viene applicato dalla vista."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete family, ordered by Kit by decreasing absolute log ratio, then increasing term for ties. The view applies no p-value filter or reordering."
          }
        }
      }
    },
