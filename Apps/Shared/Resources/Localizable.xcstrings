    "statistics.contrasts.help": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga per contrasto, un coefficiente per gruppo nell’ordine dei dati. I coefficienti devono sommare a zero e non essere tutti nulli. Il contratto usa varianza pooled e intervalli non aggiustati; le p Bonferroni e BH riguardano l’intera famiglia dichiarata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One row per contrast, one coefficient per group in data order. Coefficients must sum to zero and cannot all be zero. The contract uses pooled variance and unadjusted intervals; Bonferroni and BH p-values cover the entire declared family."
          }
        }
      }
    },
