    "advanced.rules-help" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni codice inizia con * seguito dal nome; nella riga successiva scrivi termini o espressioni. Sono supportati booleani, frasi e prossimità. Lemmi e parti del discorso non vengono inventati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each code starts with * followed by its name; put terms or expressions on the next line. Boolean, phrase and proximity rules are supported. Lemmas and parts of speech are not invented."
          }
        }
      }
    },
