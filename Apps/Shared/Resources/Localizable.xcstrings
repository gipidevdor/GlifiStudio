      }
    },
    "keyness.mac.groups.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegna ogni fonte all’obiettivo o al riferimento. Assegnarla a un gruppo la rimuove dall’altro; premi di nuovo per escluderla. Servono due gruppi non vuoti e senza fonti condivise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assign each source to the target or reference. Assigning it to one group removes it from the other; press again to exclude it. Both groups must be nonempty and share no sources."
          }
        }
      }
    },
