            "value" : "IDF usa il numero di documenti che contengono il termine. Senza IDF il metodo è solo TF. Con IDF non smussata, un termine presente in tutti i documenti ha peso zero; la variante smussata mantiene un fattore positivo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDF uses the number of documents containing a term. Without IDF the method is TF only. With unsmoothed IDF, a term in every document has zero weight; smooth IDF keeps a positive factor."
          }
        }
      }
    },
    "weighting.normalization.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La normalizzazione si applica ai pesi dell’intera riga dopo TF e IDF: nessuna, somma assoluta L1 o lunghezza euclidea L2. Una riga con soli pesi zero rimane a zero."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalization applies to the whole row after TF and IDF: none, absolute sum L1, or Euclidean length L2. A row with only zero weights stays zero."
          }
        }
      }
    },
