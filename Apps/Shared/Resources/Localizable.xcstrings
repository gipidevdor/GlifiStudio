    "failure.keyness.invalid-result" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il risultato del confronto contiene dati incoerenti e non può essere mostrato. I risultati precedenti restano disponibili."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The comparison result contains inconsistent data and cannot be displayed. Previous results remain available."
          }
        }
      }
    },
    "failure.keyness.invalid-options" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla i parametri: limite di ipotesi intero non negativo, soglia diagnostica finita non negativa e livello di confidenza finito strettamente fra 0 e 1."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the parameters: a nonnegative integer hypothesis limit, a finite nonnegative diagnostic threshold, and a finite confidence level strictly between 0 and 1."
          }
        }
      }
    },
    "failure.keyness.hypothesis-limit-exceeded" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intera famiglia di termini supera il limite di ipotesi richiesto. Aumenta il limite o modifica i gruppi; nessun risultato è stato troncato."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The full term family exceeds the requested hypothesis limit. Increase the limit or change the groups; no result has been truncated."
          }
        }
      }
    },
    "failure.keyness.empty-token-population" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almeno un gruppo non contiene token lessicali. Modifica le fonti assegnate ai gruppi prima di riprovare."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least one group contains no lexical tokens. Change the sources assigned to the groups before retrying."
          }
        }
      }
    },
    "failure.keyness.degenerate-margin" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il confronto produce una tabella con margini degeneri e non può essere calcolato. Modifica le popolazioni da confrontare."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The comparison produces a table with degenerate margins and cannot be computed. Change the populations being compared."
          }
        }
      }
    },
    "failure.keyness.empty-family" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gruppi non producono termini da confrontare. Modifica le fonti assegnate prima di riprovare."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The groups produce no terms to compare. Change the assigned sources before retrying."
          }
        }
      }
    },
