        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These revisions belong to the result, even if you have since changed the comparison groups."
          }
        }
      }
    },
    "keyness.mac.interpretation.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La direzione segue il log ratio dei tassi corretti: positivo verso l’obiettivo, negativo verso il riferimento, zero per tassi corretti uguali. Effetto, intervallo e p/q-value descrivono aspetti distinti; nessun termine viene dichiarato automaticamente significativo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direction follows the log ratio of corrected rates: positive toward the target, negative toward the reference, zero for equal corrected rates. Effect, interval, and p/q-values describe distinct aspects; no term is automatically declared significant."
          }
        }
      }
    },
    "keyness.mac.terms.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i termini del confronto"
