    "advanced.tool.mds.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappare le somiglianze (MDS)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map similarities (MDS)"
          }
        }
      }
    },
    "advanced.tool.mds.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta le fonti attraverso le distanze del loro lessico e rappresentale su uno o due assi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare sources through lexical distances and display them on one or two axes."
          }
        }
      }
    },
    "advanced.tool.mds.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mappa approssima le distanze: considera lo stress e la convergenza. Il coseno non è definito per documenti privi dei termini selezionati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map approximates distances: consider stress and convergence. Cosine distance is undefined for documents containing none of the selected terms."
          }
        }
      }
    },
    "advanced.tool.som.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizzare su una griglia (SOM)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize on a grid (SOM)"
          }
        }
      }
    },
    "advanced.tool.som.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponi documenti lessicalmente simili in celle vicine di una mappa auto-organizzante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place lexically similar documents in nearby cells of a self-organizing map."
          }
        }
      }
    },
    "advanced.tool.som.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La griglia non garantisce la conservazione delle distanze globali. Controlla errore di quantizzazione, errore topografico e arresto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grid does not guarantee preservation of global distances. Check quantization error, topographic error and the stopping condition."
          }
        }
      }
    },
    "advanced.tool.clara.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppare i documenti (CLARA)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group documents (CLARA)"
          }
        }
      }
    },
    "advanced.tool.clara.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma gruppi e identifica una fonte rappresentativa per ciascuno usando medoidi campionati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Form clusters and identify a representative source for each using sampled medoids."
          }
        }
      }
    },
    "advanced.tool.clara.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CLARA è un’approssimazione campionata con distanza euclidea sui conteggi selezionati; il numero di gruppi è una scelta esplicita."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLARA is a sampled approximation using Euclidean distance on the selected counts; the cluster count is an explicit choice."
          }
        }
      }
    },
    "advanced.tool.topics.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplorare i temi (LDA)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore topics (LDA)"
          }
        }
      }
    },
    "advanced.tool.topics.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamina temi probabilistici, parole associate e proporzioni dei temi in ogni documento."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect probabilistic topics, associated words and topic proportions in each document."
          }
        }
      }
    },
    "advanced.tool.topics.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I temi richiedono interpretazione. La perplessità è calcolata sui dati di training e non misura la qualità su dati esterni. La tabella mostra i termini richiesti e tutte le proporzioni per documento; il JSON contiene il risultato completo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topics require interpretation. Perplexity is calculated on training data and does not measure quality on external data. The table shows the requested terms and all document proportions; JSON contains the complete result."
          }
        }
      }
    },
    "advanced.tool.classification.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Classificare nuovi documenti"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classify new documents"
          }
        }
      }
    },
    "advanced.tool.classification.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Addestra Naive Bayes con fonti etichettate e prevedi la classe delle altre fonti selezionate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Train Naive Bayes with labeled sources and predict the class of other selected sources."
          }
        }
      }
    },
    "advanced.tool.classification.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le probabilità del modello non sono confidenze calibrate. I token fuori dal vocabolario di addestramento vengono contati e ignorati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model probabilities are not calibrated confidence. Tokens outside the training vocabulary are counted and ignored."
          }
        }
      }
    },
    "advanced.tool.classifierValidation.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificare il classificatore"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluate the classifier"
          }
        }
      }
    },
    "advanced.tool.classifierValidation.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura le previsioni su partizioni escluse dall’addestramento e controlla la matrice di confusione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure predictions on folds excluded from training and inspect the confusion matrix."
          }
        }
      }
    },
    "advanced.tool.classifierValidation.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni fold ricostruisce il vocabolario senza dati di test. L’accuratezza riguarda questo corpus e queste classi; non garantisce prestazioni su altri dati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each fold rebuilds the vocabulary without test data. Accuracy applies to this corpus and these classes; it does not guarantee performance on other data."
          }
        }
      }
    },
    "advanced.tool.coding.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicare regole ai testi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply rules to texts"
          }
        }
      }
    },
    "advanced.tool.coding.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica uno o più codici ai documenti tramite regole riproducibili e verifica quante evidenze positive sostengono ogni assegnazione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply one or more codes to documents through reproducible rules and inspect the positive evidence supporting each assignment."
          }
        }
      }
    },
    "advanced.tool.coding.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I codici automatici restano separati dalla codifica manuale persistita. Le negazioni possono assegnare un codice senza un intervallo positivo; non viene inventato."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic codes remain separate from persisted manual coding. Negation may assign a code without a positive span; none is invented."
          }
        }
      }
    },
    "advanced.tool.codeCrosstab.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confrontare codici fra gruppi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare codes across groups"
          }
        }
      }
    },
    "advanced.tool.codeCrosstab.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta i documenti che soddisfano ciascun codice nei gruppi assegnati, conservando denominatori e dati mancanti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count documents matching each code in the assigned groups, retaining denominators and missing data."
          }
        }
      }
    },
    "advanced.tool.codeCrosstab.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni documento può ricevere più codici. I conteggi non devono sommare al denominatore. I gruppi mancanti sono dichiarati separatamente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each document may receive multiple codes. Counts need not sum to the denominator. Missing groups are reported separately."
          }
        }
      }
    },
    "advanced.tool.distances.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confrontare le distanze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare distances"
          }
        }
      }
    },
    "advanced.tool.distances.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamina le distanze fra ogni coppia di documenti usando la stessa matrice di termini."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect distances between every pair of documents using the same term matrix."
          }
        }
      }
    },
    "advanced.tool.distances.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il significato della distanza dipende dalla metrica e dai termini selezionati. Le coppie sono mostrate una volta; la diagonale è zero."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance meaning depends on the metric and selected terms. Pairs are shown once; the diagonal is zero."
          }
        }
      }
    },
    "advanced.tool.correspondence.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizzare le corrispondenze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze correspondences"
          }
        }
      }
    },
    "advanced.tool.correspondence.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora le relazioni fra documenti e termini dalla loro tabella di conteggi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore relationships between documents and terms from their count table."
          }
        }
      }
    },
    "advanced.tool.correspondence.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabella riporta gli assi disponibili. Fonti o termini a massa zero sono esclusi; l’inerzia totale e il numero di fonti incluse restano espliciti. Le diagnostiche complete sono nel JSON."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table reports available axes. Sources or terms with zero mass are excluded; total inertia and included-source count remain explicit. Complete diagnostics are in JSON."
          }
        }
      }
    },
    "advanced.tool.hierarchical.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruire una gerarchia di gruppi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a cluster hierarchy"
          }
        }
      }
    },
    "advanced.tool.hierarchical.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa progressivamente i documenti in base alle distanze e al criterio di aggregazione scelto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progressively group documents according to the selected distances and linkage."
          }
        }
      }
    },
    "advanced.tool.hierarchical.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni unione forma un nuovo gruppo. Il legame singolo, completo o medio lavora sulle dissimilarità dichiarate; Ward non viene applicato a distanze non euclidee."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each merge forms a new cluster. Single, complete or average linkage uses the stated dissimilarities; Ward is not applied to non-Euclidean distances."
          }
        }
      }
    },
    "advanced.tool.network.title" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplorare le co-occorrenze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore co-occurrences"
          }
        }
      }
    },
    "advanced.tool.network.description" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Individua coppie di termini presenti negli stessi documenti e misura la loro associazione Jaccard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find term pairs occurring in the same documents and measure their Jaccard association."
          }
        }
      }
    },
    "advanced.tool.network.caveat" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli archi descrivono co-presenza per documento, non causalità. Soglia, vocabolario e limite degli archi determinano il risultato; un limite superato produce un errore esplicito."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edges describe document-level co-presence, not causality. Threshold, vocabulary and edge limit determine the result; exceeding a limit produces an explicit error."
          }
        }
      }
    },
    "advanced.pane" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
