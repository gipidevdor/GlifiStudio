      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori iniziali: 100 000 ipotesi, soglia diagnostica 5, livello di confidenza 0,95. I controlli preparano una nuova richiesta e non cambiano il risultato precedente."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Initial settings: 100,000 hypotheses, diagnostic threshold 5, confidence level 0.95. Controls prepare a new request and do not change the previous result."
          }
        }
      }
    },
    "keyness.mac.parameters.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Famiglia, test e intervalli"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family, tests, and intervals"
          }
        }
      }
    },
    "keyness.mac.family.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il limite di ipotesi è un intero non negativo: se l’intera famiglia supera il limite, il calcolo fallisce. Non seleziona i primi termini e non tronca la famiglia usata dalla correzione Benjamini–Hochberg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hypothesis limit is a nonnegative integer: if the full family exceeds the limit, computation fails. It does not select top terms or truncate the family used by the Benjamini–Hochberg correction."
          }
        }
      }
    },
    "keyness.mac.selection.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fisher a due code è scelto quando il minimo atteso della tabella è minore di 5; altrimenti si usa il G-test. Questa regola fissa dipende dai margini e resta distinta dalla soglia diagnostica configurabile, finita e non negativa."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two-sided Fisher is selected when the minimum expected table count is below 5; otherwise the G-test is used. This fixed rule depends on the margins and remains separate from the configurable, finite, nonnegative diagnostic threshold."
          }
        }
      }
    },
    "keyness.mac.confidence.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello deve essere finito e strettamente fra 0 e 1. Gli intervalli Katz e Woolf usano la correzione Haldane–Anscombe (+0,5 alle quattro celle). Con dati rari possono essere ampi. Livelli estremamente vicini a 1 possono fallire per limiti numerici: correggi la richiesta senza attendere un adattamento automatico."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The level must be finite and strictly between 0 and 1. Katz and Woolf intervals use the Haldane–Anscombe correction (+0.5 in all four cells). With rare data, intervals may be wide. Levels extremely close to 1 can fail due to numerical limits: correct the request; no automatic adjustment is applied."
          }
        }
      }
    },
