            "value": "Advanced analysis"
          }
        }
      }
    },
    "advanced.introduction" : {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora i documenti con mappe, gruppi, temi e regole. Scegli un obiettivo, verifica le fonti e avvia l’analisi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore documents with maps, groups, topics and rules. Choose a goal, check the sources and run the analysis."
          }
        }
      }
    },
    "advanced.progress" : {
      "extractionState": "manual",
      "localizations": {
