+
+private func appleDescriptiveSortingInputDigest(
+    _ observations: [Double?], recipe: String, probabilities: [Double]
+) throws -> String {
+    let configuration = AppleDescriptiveSortingInputDescription(
+        recipe: recipe, unit: "synthetic-observation-v1", variance: "sample",
+        probabilities: probabilities.map(\.bitPattern), observationCount: observations.count)
+    let encoder = JSONEncoder()
+    encoder.outputFormatting = [.sortedKeys]
+    var hasher = SHA256()
+    hasher.update(data: try encoder.encode(configuration))
+    var buffer = Data()
+    buffer.reserveCapacity(65_536)
+    for value in observations {
+        if let value {
+            buffer.append(1)
+            var bits = value.bitPattern.littleEndian
+            withUnsafeBytes(of: &bits) { buffer.append(contentsOf: $0) }
+        } else {
+            buffer.append(0)
+        }
+        if buffer.count >= 65_536 {
+            hasher.update(data: buffer)
+            buffer.removeAll(keepingCapacity: true)
+        }
+    }
+    hasher.update(data: buffer)
+    return hasher.finalize().map { String(format: "%02x", $0) }.joined()
+}
+
+private struct AppleDescriptiveSortingInputDescription: Encodable {
+    let recipe: String
+    let unit: String
+    let variance: String
+    let probabilities: [UInt64]
+    let observationCount: Int
+}
+
+private func appleDescriptiveSortingDigest(_ value: some Encodable) throws -> String {
+    let encoder = JSONEncoder()
+    encoder.outputFormatting = [.sortedKeys]
+    return SHA256.hash(data: try encoder.encode(value)).map { String(format: "%02x", $0) }.joined()
+}
+
+private func appleDescriptiveSortingSourceHashes() throws -> [String: String] {
+    let sources = URL(filePath: #filePath).deletingLastPathComponent().deletingLastPathComponent()
+    let paths = [
+        "GlifiCore/GlifiDescriptiveStatistics.swift",
+        "GlifiBenchmark/GlifiAppleDescriptiveSortingBenchmarks.swift", "GlifiBenchmark/main.swift",
+    ]
+    return try Dictionary(
+        uniqueKeysWithValues: paths.map { path in
+            let bytes = try Data(contentsOf: sources.appending(path: path))
+            return (path, SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined())
+        })
+}
+
+private func appleDescriptiveSortingPeakRSS() -> UInt64 {
+    var usage = rusage()
+    guard getrusage(RUSAGE_SELF, &usage) == 0 else { return 0 }
+    return UInt64(max(0, usage.ru_maxrss))
+}
+
+private func appleDescriptiveSortingToolchain() -> String {
+    #if os(macOS)
+        let process = Process()
+        process.executableURL = URL(filePath: "/usr/bin/xcrun")
+        process.arguments = ["swift", "--version"]
+        let output = Pipe()
+        process.standardOutput = output
+        process.standardError = output
+        do {
+            try process.run()
+            process.waitUntilExit()
+            return String(
+                decoding: output.fileHandleForReading.readDataToEndOfFile(), as: UTF8.self
+            )
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        } catch {
+            return "unavailable; capture swift --version externally"
+        }
+    #else
+        return "capture the build toolchain externally"
+    #endif
+}
