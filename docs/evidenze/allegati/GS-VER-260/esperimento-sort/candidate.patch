+private func appleDescriptiveSortingCases() -> [AppleDescriptiveSortingCase] {
+    var result = [4_096, 16_384, 32_768, 65_536, 131_072, 500_000, 1_000_000].map { count in
+        AppleDescriptiveSortingCase(
+            identifier: "continuous-\(count)", count: count, kind: .continuous,
+            recipe: "SplitMix64 seed260; alternating signs; magnitude1+uniform*1e6; all normal")
+    }
+    result += [
+        .init(
+            identifier: "continuous-missing-500000", count: 500_000, kind: .continuousMissing,
+            recipe: "SplitMix64 seed260; origin1e12; integer spread1000003/8; every17th missing"),
+        .init(
+            identifier: "repeated-500000", count: 500_000, kind: .repeated,
+            recipe: "31 cyclic normal values1+(index%31)/8; counted-sort control"),
+        .init(
+            identifier: "nearly-sorted-500000", count: 500_000, kind: .nearlySorted,
+            recipe: "ascending values1+index/8; final adjacent pair inverted; no early inversion"),
+        .init(
+            identifier: "late-cardinality-500000", count: 500_000, kind: .lateCardinality,
+            recipe: "256 ascending nonzero blocks, one midpoint inversion, then256 new types"),
+        .init(
+            identifier: "signed-zero-tail-500000", count: 500_000, kind: .signedZeroTail,
+            recipe: "descending normal values1+(count-index)/8; append +0,-0,+0,-0"),
+        .init(
+            identifier: "subnormal-tail-500000", count: 500_000, kind: .subnormalTail,
+            recipe: "descending normal values1+(count-index)/8; append +/-leastNonzeroMagnitude"),
+        .init(
+            identifier: "sparse-missing-500000", count: 500_000, kind: .sparseMissing,
+            recipe: "every1024th observation finite1+(index%31)/8; other observations missing"),
+        .init(
+            identifier: "all-missing-500000", count: 500_000, kind: .allMissing,
+            recipe: "500000 missing observations; no sorting work"),
+    ]
+    return result
+}
+
+private func appleDescriptiveSortingFixture(_ specification: AppleDescriptiveSortingCase)
+    -> [Double?]
+{
+    let count = specification.count
+    switch specification.kind {
+    case .continuous:
+        var generator = GlifiSplitMix64(seed: 260)
+        return (0..<count).map { index in
+            let magnitude = 1 + Double(generator.next() >> 11) / Double(1 << 53) * 1e6
+            return index.isMultiple(of: 2) ? magnitude : -magnitude
+        }
+    case .continuousMissing:
+        var generator = GlifiSplitMix64(seed: 260)
+        return (0..<count).map { index in
+            index.isMultiple(of: 17)
+                ? nil : 1e12 + Double(generator.next() % 1_000_003) / 8
+        }
+    case .repeated: return (0..<count).map { 1 + Double($0 % 31) / 8 }
+    case .nearlySorted:
+        var values: [Double?] = (0..<count).map { 1 + Double($0) / 8 }
+        values.swapAt(count - 2, count - 1)
+        return values
+    case .lateCardinality:
+        let prefixCount = count - 256
+        var values: [Double?] = (0..<count).map { index in
+            index < prefixCount
+                ? 1 + Double(index * 256 / prefixCount) / 8
+                : 33 + Double(index - prefixCount) / 8
+        }
+        values.swapAt(prefixCount / 2 - 1, prefixCount / 2)
+        return values
+    case .signedZeroTail:
+        return (0..<count).map { Double?.some(1 + Double(count - $0) / 8) }
+            + [0.0, -0.0, 0.0, -0.0]
+    case .subnormalTail:
+        return (0..<count).map { Double?.some(1 + Double(count - $0) / 8) }
+            + [Double.leastNonzeroMagnitude, -Double.leastNonzeroMagnitude]
+    case .sparseMissing:
+        return (0..<count).map { $0.isMultiple(of: 1_024) ? 1 + Double($0 % 31) / 8 : nil }
+    case .allMissing: return [Double?](repeating: nil, count: count)
+    }
+}
+
+private func appleDescriptiveSortingMeasurement(
+    _ specification: AppleDescriptiveSortingCase, mode: AppleDescriptiveSortingMode
+) throws -> AppleDescriptiveSortingMeasurement {
+    let observations = appleDescriptiveSortingFixture(specification)
+    let probabilities = [1.0, 0, 0.01, 0.25, 0.5, 0.75, 0.99]
+    let inputDigest = try appleDescriptiveSortingInputDigest(
+        observations, recipe: specification.recipe, probabilities: probabilities)
+    let expected = try appleBenchmarkSwiftReferenceSummary(
+        observations, unitIdentifier: "synthetic-observation-v1", variance: .sample,
+        probabilities: probabilities)
+    let expectedBits = appleDescriptiveSortingBits(expected)
+    let outputDigest = try appleDescriptiveSortingDigest(expectedBits)
+    let initialThermal = String(describing: ProcessInfo.processInfo.thermalState)
+    let initialRSS = appleDescriptiveSortingPeakRSS()
+    var referenceTimes: [Double] = []
+    var candidateTimes: [Double] = []
+    var order: [String] = []
+    func runReference() throws -> Double {
+        let start = DispatchTime.now().uptimeNanoseconds
+        let value = try appleBenchmarkSwiftReferenceSummary(
+            observations, unitIdentifier: "synthetic-observation-v1", variance: .sample,
+            probabilities: probabilities)
+        let elapsed = Double(DispatchTime.now().uptimeNanoseconds - start) / 1e9
+        guard appleDescriptiveSortingBits(value) == expectedBits else {
+            throw AppleDescriptiveSortingBenchmarkFailure.inconsistentResult(
+                specification.identifier)
+        }
+        return elapsed
+    }
+    func runCandidate() throws -> Double {
+        let start = DispatchTime.now().uptimeNanoseconds
+        let value = try GlifiDescriptiveStatistics.summarize(
+            observations, unitIdentifier: "synthetic-observation-v1", variance: .sample,
+            probabilities: probabilities)
+        let elapsed = Double(DispatchTime.now().uptimeNanoseconds - start) / 1e9
+        guard appleDescriptiveSortingBits(value) == expectedBits else {
+            throw AppleDescriptiveSortingBenchmarkFailure.inconsistentResult(
+                specification.identifier)
+        }
+        return elapsed
+    }
+    switch mode {
+    case .paired:
+        _ = try runReference()
+        _ = try runCandidate()
+    case .reference: _ = try runReference()
+    case .candidate: _ = try runCandidate()
+    }
+    for sample in 0..<7 {
+        switch mode {
+        case .paired:
+            if sample.isMultiple(of: 2) {
+                order.append("reference,candidate")
+                referenceTimes.append(try runReference())
+                candidateTimes.append(try runCandidate())
+            } else {
+                order.append("candidate,reference")
+                candidateTimes.append(try runCandidate())
+                referenceTimes.append(try runReference())
+            }
+        case .reference:
+            order.append("reference")
+            referenceTimes.append(try runReference())
+        case .candidate:
+            order.append("candidate")
+            candidateTimes.append(try runCandidate())
+        }
+    }
+    return AppleDescriptiveSortingMeasurement(
+        identifier: specification.identifier, recipe: specification.recipe,
+        inputSHA256: inputDigest, outputSHA256: outputDigest,
+        observationCount: observations.count, validCount: expected.validCount,
+        thermalStateAtStart: initialThermal,
+        thermalStateAtEnd: String(describing: ProcessInfo.processInfo.thermalState),
+        processPeakRSSBytesBefore: initialRSS,
+        processPeakRSSBytesAfter: appleDescriptiveSortingPeakRSS(), sampleOrder: order,
+        reference: appleDescriptiveSortingTiming(referenceTimes),
+        candidate: appleDescriptiveSortingTiming(candidateTimes),
+        allResultsMatchReferenceBitwise: true)
+}
+
+private func appleDescriptiveSortingTiming(_ times: [Double]) -> AppleDescriptiveSortingTiming? {
+    guard !times.isEmpty else { return nil }
+    let ordered = times.sorted()
+    return AppleDescriptiveSortingTiming(
+        rawSeconds: times, medianSeconds: ordered[ordered.count / 2],
+        minimumSeconds: ordered.first ?? 0, maximumSeconds: ordered.last ?? 0)
+}
