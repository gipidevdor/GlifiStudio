+@Test("Il sort Apple descrittivo conserva tutti i bit sopra e sotto la soglia candidata")
+func appleDescriptiveSortMatchesSwiftBitwise() throws {
+    let threshold = GlifiDescriptiveStatistics.minimumAcceleratedSortCount
+    for count in [threshold - 1, threshold, threshold + 1, 131_072] {
+        for seed: UInt64 in [260, 261] {
+            var generator = GlifiSplitMix64(seed: seed)
+            let input = (0..<count).map { _ in
+                (Double(generator.next() >> 11) / Double(1 << 53) - 0.5) * 1e6 + 0.125
+            }
+            var observed = input
+            try GlifiDescriptiveStatistics.sortFiniteValues(&observed)
+            #expect(observed.map(\.bitPattern) == input.sorted().map(\.bitPattern))
+        }
+    }
+}
+
+@Test("Zeri e subnormali tardivi mantengono il riferimento Swift del sort descrittivo")
+func appleDescriptiveSortRetainsExceptionalFallbacks() throws {
+    let count = max(65_536, GlifiDescriptiveStatistics.minimumAcceleratedSortCount + 1)
+    let input = (0..<count).map { Double(count - $0) / 8 + 1 }
+    for tail in [
+        [0.0, -0.0, 0.0, -0.0],
+        [Double.leastNonzeroMagnitude, -Double.leastNonzeroMagnitude],
+        [Double.leastNormalMagnitude.nextDown, -Double.leastNormalMagnitude.nextDown],
+    ] {
+        for position in [0, count / 2, count] {
+            var fixture = input
+            fixture.insert(contentsOf: tail, at: position)
+            var observed = fixture
+            try GlifiDescriptiveStatistics.sortFiniteValues(&observed)
+            #expect(observed.map(\.bitPattern) == fixture.sorted().map(\.bitPattern))
+        }
+    }
+}
+
+@Test("Il risultato descrittivo Apple completo coincide bitwise con il riferimento Swift")
+func appleDescriptiveSummaryMatchesCompleteSwiftReference() throws {
+    let count = max(65_536, GlifiDescriptiveStatistics.minimumAcceleratedSortCount + 1)
+    var generator = GlifiSplitMix64(seed: 260)
+    let continuous: [Double?] = (0..<count).map { index in
+        index.isMultiple(of: 17)
+            ? nil : 1e12 + Double(generator.next() % 1_000_003) / 8
+    }
+    let repeated: [Double?] = (0..<count).map { Double($0 % 31 + 1) / 8 }
+    let highCardinality: [Double?] = (0..<count).map { Double(count - $0) / 8 + 1 }
+    var nearlySorted: [Double?] = (0..<count).map { Double($0 + 1) / 8 }
+    nearlySorted.swapAt(count - 2, count - 1)
+    let fixtures = [
+        continuous, repeated, nearlySorted,
+        highCardinality + [0.0, -0.0, nil, Double.leastNonzeroMagnitude],
+        [nil, nil], [Double?.some(1)], [],
+    ]
+    let probabilities = [1.0, 0, 0.01, 0.75, 0.5, 0.25, 0.99]
+    for variance in [GlifiVarianceConvention.population, .sample] {
+        for fixture in fixtures {
+            let expected = try appleSwiftReferenceSummary(
+                fixture, unitIdentifier: "synthetic-observation-v1", variance: variance,
+                probabilities: probabilities)
+            let observed = try GlifiDescriptiveStatistics.summarize(
+                fixture, unitIdentifier: "synthetic-observation-v1", variance: variance,
+                probabilities: probabilities)
+            #expect(appleDescriptiveSummaryBits(observed) == appleDescriptiveSummaryBits(expected))
+        }
+    }
+}
+
+@Test("Il percorso Apple conserva le failure di dominio e la cancellazione prima del sort")
+func appleDescriptiveSortPreservesFailureAndCancellation() async {
+    #expect(throws: GlifiFailure.self) {
+        try GlifiDescriptiveStatistics.summarize(
+            [1, .nan], unitIdentifier: "synthetic-observation-v1", variance: .sample)
+    }
+    let task = Task {
+        withUnsafeCurrentTask { $0?.cancel() }
+        var values = (1...65_536).reversed().map(Double.init)
+        try GlifiDescriptiveStatistics.sortFiniteValues(&values)
+    }
+    await #expect(throws: CancellationError.self) { try await task.value }
+}
