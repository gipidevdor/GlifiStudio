+private struct AppleDescriptiveSummaryBits: Equatable {
+    let method: String
+    let unit: String
+    let missingPolicy: String
+    let varianceConvention: GlifiVarianceConvention
+    let validCount: Int
+    let missingCount: Int
+    let scalars: [UInt64?]
+    let quantileProbabilities: [UInt64]
+    let quantileValues: [UInt64?]
+}
