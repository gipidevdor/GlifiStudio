+private func appleDescriptiveSortingBits(_ value: AppleDescriptiveReferenceSummary)
+    -> AppleDescriptiveSortingBits
+{
+    AppleDescriptiveSortingBits(
+        method: value.methodIdentifier, unit: value.unitIdentifier,
+        missingPolicy: value.missingPolicyIdentifier,
+        varianceConvention: value.varianceConvention.rawValue,
+        validCount: value.validCount, missingCount: value.missingCount,
+        scalars: [
+            value.minimum, value.maximum, value.mean, value.median, value.variance,
+            value.standardDeviation,
