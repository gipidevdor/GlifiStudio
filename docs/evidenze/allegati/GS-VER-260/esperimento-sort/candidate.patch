+/// Paired measurements use alternating order and check every warm-up and timed result.
+///
+/// Reference-only and candidate-only modes also allow separate process-RSS observations.
+func appleDescriptiveSortingBenchmarkReport() throws -> AppleDescriptiveSortingBenchmarkReport {
+    #if DEBUG
+        throw AppleDescriptiveSortingBenchmarkFailure.releaseRequired
+    #else
+        var mode = AppleDescriptiveSortingMode.paired
+        var caseFilter: String?
+        for argument in CommandLine.arguments.dropFirst() {
+            switch argument {
+            case "--apple-descriptive-sort": break
+            case "--reference-only": mode = .reference
+            case "--candidate-only": mode = .candidate
+            default:
+                guard argument.hasPrefix("--case=") else {
+                    throw AppleDescriptiveSortingBenchmarkFailure.unknownArgument(argument)
+                }
+                caseFilter = String(argument.dropFirst("--case=".count))
+            }
+        }
+        let sourceHashes = try appleDescriptiveSortingSourceHashes()
+        let initialThermal = String(describing: ProcessInfo.processInfo.thermalState)
+        let initialLowPower = ProcessInfo.processInfo.isLowPowerModeEnabled
+        let initialRSS = appleDescriptiveSortingPeakRSS()
+        let selected = appleDescriptiveSortingCases().filter { specification in
+            caseFilter == nil || specification.identifier == caseFilter
+        }
+        guard !selected.isEmpty else {
+            throw AppleDescriptiveSortingBenchmarkFailure.unknownCase(caseFilter ?? "")
+        }
+        var measurements: [AppleDescriptiveSortingMeasurement] = []
+        for specification in selected {
+            measurements.append(try appleDescriptiveSortingMeasurement(specification, mode: mode))
+        }
+        guard try appleDescriptiveSortingSourceHashes() == sourceHashes else {
+            throw AppleDescriptiveSortingBenchmarkFailure.sourcesChanged
+        }
+        return AppleDescriptiveSortingBenchmarkReport(
+            generatedAt: ISO8601DateFormatter().string(from: Date()), device: hardwareModel(),
+            operatingSystem: ProcessInfo.processInfo.operatingSystemVersionString,
+            toolchain: appleDescriptiveSortingToolchain(),
+            physicalMemoryBytes: ProcessInfo.processInfo.physicalMemory,
+            activeProcessorCount: ProcessInfo.processInfo.activeProcessorCount,
+            thermalStateAtStart: initialThermal,
+            thermalStateAtEnd: String(describing: ProcessInfo.processInfo.thermalState),
+            lowPowerModeAtStart: initialLowPower,
+            lowPowerModeAtEnd: ProcessInfo.processInfo.isLowPowerModeEnabled,
+            processPeakRSSBytesAtStart: initialRSS,
+            processPeakRSSBytesAtEnd: appleDescriptiveSortingPeakRSS(),
+            rssScope:
+                "Darwin getrusage process high-water RSS in bytes; includes fixture generation, "
+                + "both implementations, untimed checks and digest buffers; not isolated kernel memory",
+            configuration: "Release; --apple-descriptive-sort; mode=\(mode.rawValue)",
+            reference:
+                "Complete pre-Accelerate Swift summary, including bounded counted sort and fallback",
+            candidateMinimumCount: GlifiDescriptiveStatistics.minimumAcceleratedSortCount,
+            timingScope:
+                "Complete summarize call: validation, compaction/copies, eligibility, sort, "
+                + "Q7 and all numeric reductions; fixture setup and complete bitwise checks are untimed",
+            warmUpRunsPerImplementation: 1, samplesPerImplementation: 7,
+            sourceHashes: sourceHashes, measurements: measurements)
+    #endif
+}
